	(text "--Conduction Mode Check--\nL_{1,min} = (1-D)^{2}R/2Df_{s} = (1-0.6)^{2}*15/2*0.6*10^{5} = 20uH\nL_{1} = 200uH > L_{1,min}\n\nL_{2,min} = (1-D)R/2f_{s} = (1-0.6)*15/2*10^{5} = 30uH\nL_{2} = 300uH > L_{1,min}"
		(exclude_from_sim no)
		(at 19.05 145.542 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "2a7cab91-e2cc-42f6-a9ca-a8705c776e79")
	)
	(text "SEPIC Converter"
		(exclude_from_sim no)
		(at 208.28 34.798 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.6)
				(bold yes)
			)
		)
		(uuid "2fdc1e4a-1c9f-46da-a8f6-b10c59402f5d")
	)
	(text "--Inductor Values--\nPeak-Peak Inductor Currents (We will select 20%)\nΔI_{L1} = 0.2I_{L1} = 0.2 * 7.5 = 1.5A\nΔI_{L2} = 0.2I_{L2} = 0.2 * 5 = 1A\n\nL_{1} = D*V_{S}/ΔI_{L1}*f_{s} = 0.6*50/1.5*10^{5} = 200uH\nL_{2} = D*V_{S}/ΔI_{L2}*f_{s} = 0.6*50/1*10^{5} = 300uH\n\n--Capacitor Values--\nAverage Capacitor Voltage C_{1}: \nV_{S} = V_{L1} + V_{C1} - V_{L2}\nV_{C1} = V_{S} - V_{L1} + V_{L2} = 50 - 0 + 0 = 50V\n\nΔV_{C2} = ΔV_{o} = D*V_{o}/R*C_{2}*f_{s} \n-> C_{2} = D/(ΔV_{o}/V_{o})*R*f_{s} = 0.6/(0.01*15*10^{5}) = 40uF\n\nΔV_{C1} = ΔQ_{C1}/C_{1} = I_{o}Δt/C_{1} =I_{o}*D*T/C_{1} = (V_{o}/R)*D*T/C_{1} = D*V_{o}/R*C_{1}*f_{s}\n-> C_{1} = D/(ΔV_{C1}/V_{o})*R*f_{s} = 0.6/(0.02*15*10^{5}) = 20uF\n"
		(exclude_from_sim no)
		(at 20.574 110.998 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "34b32840-1773-46c8-85e5-84a29faea234")
	)
	(text "R for f_{s} = 250kHz"
		(exclude_from_sim no)
		(at 169.926 102.362 0)
		(effects
